DATABASE_URL="postgresql://fitness:fitness@127.0.0.1:5433/fitnessdb"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development
# Для production обязательно укажи фронтовые origin'ы через запятую
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_DAYS="7"
# Срок жизни opaque refresh-токена (дни); сам токен хранится только на клиенте, в БД — SHA-256 хеш
JWT_REFRESH_DAYS="30"
# Для продакшена должен быть true (только HTTPS)
COOKIE_SECURE="false"
# Путь до PDF-шаблона договора с AcroForm полями
CONTRACT_TEMPLATE_PATH="./templates/contract-template.pdf"
# Путь до HTML-шаблона договора c {{placeholders}}
CONTRACT_TEMPLATE_HTML_PATH="./templates/contract-template.html"
DADATA_API_KEY=""
# Необязательно: кастомный URL провайдера подсказок адреса
DADATA_ADDRESS_SUGGEST_URL="https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address"
# Открытый визит IN_GYM без выхода переводится в OVERDUE при смене календарного дня по Europe/Moscow (см. VisitsService + крон 00:00 MSK).

# --- S3 / MinIO (договоры PDF, фото клиентов). Без bucket загрузка фото через API отключена.
# Для MinIO локально: endpoint http://127.0.0.1:9100, bucket создайте в консоли :9101
# База для URL объекта в БД: `S3_PUBLIC_BASE_URL` + `/` + key (path-style: http://host:port/<bucket>).
# При приватном bucket API подставляет подписанный GET в поле photoUrl на чтение; публичная политика не обязательна.
# Необязательно: срок подписи GET в секундах (по умолчанию 604800 = 7 дней).
# S3_PHOTO_READ_TTL_SEC="604800"
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE_URL=""
