# Скопируйте в deploy/.env.production на сервере и замените значения.
# cp deploy/env.production.example deploy/.env.production

# --- Postgres (пароль должен совпадать с подстановкой в docker-compose.prod.yml через DATABASE_URL)
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM

# --- Не указывайте DATABASE_URL здесь для Docker — его задаёт docker-compose.prod.yml

NODE_ENV=production

# --- Образ API из GitHub Actions (GHCR), без сборки Chromium на VPS
# После первого успешного workflow скопируйте имя из лога Summary (owner/repo в lowercase):
# API_IMAGE=ghcr.io/<github-owner-lowercase>/<repo-lowercase>/fitness-api:latest
# На сервере: echo TOKEN | docker login ghcr.io -u USERNAME --password-stdin
# Затем: docker compose ... pull api && docker compose ... up -d --no-build --force-recreate api
#
# --- Образ web (frontend) из CI (опционально)
# WEB_IMAGE=ghcr.io/<owner-lowercase>/<repo-lowercase>/fitness-web:latest
# docker compose ... pull web && docker compose ... up -d --no-build --force-recreate web

# Публичный домен (HTTPS после Certbot)
CORS_ORIGIN=https://5fit.work.gd,https://www.5fit.work.gd

JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ACCESS_DAYS=7
JWT_REFRESH_DAYS=30

# Обязательно true при HTTPS
COOKIE_SECURE=true

# Сборка образа api (docker-compose подставляет в build.args).
# На VPS ~8–10 GB держите 0: INSTALL_CHROMIUM=1 тянет системный chromium (~700MB+) и почти всегда даёт ENOSPC при build.
# С INSTALL_CHROMIUM=0 PDF из HTML — 503; собирайте образ с Chromium на большей машине/CI и делайте docker pull на сервер.
INSTALL_CHROMIUM=0

# Chromium из образа backend/Dockerfile (при INSTALL_CHROMIUM=1)
CHROME_PATH=/usr/bin/chromium

REDIS_URL=

DADATA_API_KEY=
DADATA_ADDRESS_SUGGEST_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address

# --- MinIO (опционально): сервис поднимается только с профилем:
#   docker compose --env-file deploy/.env.production -f docker-compose.prod.yml --profile minio up -d
# Без MinIO оставьте S3_BUCKET пустым — иначе API при старте будет ходить в S3 и может упасть.
#
# Логин/пароль админки MinIO = те же значения для S3-клиента в API.
MINIO_ROOT_USER=fitness
MINIO_ROOT_PASSWORD=REPLACE_STRONG_MINIO_SECRET

# CORS: браузер делает PUT на :9100 с заголовком Origin вашего SPA — перечислите те же URL, что и у сайта (http и https).
# Без этого в Network будет ошибка на presigned PUT / «Provisional headers».
MINIO_CORS_ALLOW_ORIGIN=https://5fit.work.gd,https://www.5fit.work.gd,http://5fit.work.gd,http://www.5fit.work.gd

# S3-совместимый клиент в Nest (фото клиентов, PDF и т.д.)
# S3_ENDPOINT — хост в presigned URL; должен открываться из браузера (проброс compose 9100:9000 на IP сервера или домен).
# S3_INTERNAL_ENDPOINT — вызовы SDK из контейнера api (HeadBucket, Put, Delete). На VPS часто таймаут на свой же публичный IP — ставьте http://minio:9000.
S3_REGION=us-east-1
S3_BUCKET=fitness-uploads
S3_ACCESS_KEY_ID=fitness
S3_SECRET_ACCESS_KEY=REPLACE_STRONG_MINIO_SECRET
S3_ENDPOINT=http://31.70.72.232:9100
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# База публичных URL объектов (path-style): совпадает с тем, что видит браузер после загрузки
S3_PUBLIC_BASE_URL=http://31.70.72.232:9100/fitness-uploads
